-- =============================================================================
--  GatewayMini: fatia mínima do Projeto 3 para estudar AADL.
--
--  1 sensor -> 1 processo (com 1 thread) -> interface de saída,
--  rodando sobre uma plataforma com CPU, RAM e barramento interno.
--  É o esqueleto a ser estendido: 3 sensores, 3 processos, 5 threads.
--
--  Para testar no OSATE:
--    1. salvar (valida sintaxe e regras de legalidade)
--    2. botão direito em Gateway.impl -> Instantiate
--    3. Analyses -> Timing -> Check Flow Latency
-- =============================================================================
package GatewayMini
public

  -- ------------------------------------------------------------------- dados
  -- Tipo da mensagem que trafega nas portas (RQ02)
  data Msg
    properties
      Data_Size => 16 Bytes;
  end Msg;

  -- ---------------------------------------------------------------- hardware
  bus InternalBus
  end InternalBus;

  processor Cpu
    features
      bus_ic : requires bus access InternalBus;
  end Cpu;

  memory Ram
    features
      bus_ic : requires bus access InternalBus;
    properties
      Memory_Size => 64 KByte;
  end Ram;

  -- ------------------------------------------------------------- dispositivos
  -- Sensor: caixa-preta que ORIGINA o fluxo (flow source)
  device TempSensor
    features
      msg_out : out event data port Msg;
      bus_ic  : requires bus access InternalBus;
    flows
      src : flow source msg_out;
    properties
      Dispatch_Protocol => Periodic;
      Period => 100 ms;
  end TempSensor;

  -- Saída: caixa-preta que TERMINA o fluxo (flow sink)
  device OutputIf
    features
      msg_in : in event data port Msg;
      bus_ic : requires bus access InternalBus;
    flows
      snk : flow sink msg_in;
  end OutputIf;

  -- ----------------------------------------------------------------- software
  -- Thread: quem de fato executa. A porta de entrada é uma FIFO de 8
  -- posições que descarta a mensagem mais antiga quando enche.
  thread Receiver
    features
      msg_in  : in event data port Msg {
        Queue_Size => 8;
        Overflow_Handling_Protocol => DropOldest;
      };
      msg_out : out event data port Msg;
    flows
      fp : flow path msg_in -> msg_out;
    properties
      Dispatch_Protocol => Sporadic;
      Period => 10 ms;                          -- sporadic: separação mínima
      Compute_Execution_Time => 1 ms .. 2 ms;   -- min .. pior caso (WCET)
      Deadline => 10 ms;
      Priority => 5;
  end Receiver;

  -- Processo: espaço de endereçamento que contém a thread
  process Acquisition
    features
      msg_in  : in event data port Msg;
      msg_out : out event data port Msg;
    flows
      fp : flow path msg_in -> msg_out;
  end Acquisition;

  process implementation Acquisition.impl
    subcomponents
      rx : thread Receiver;
    connections
      c_in  : port msg_in -> rx.msg_in;       -- desce: processo -> thread
      c_out : port rx.msg_out -> msg_out;     -- sobe: thread -> processo
    flows
      fp : flow path msg_in -> c_in -> rx.fp -> c_out -> msg_out;
  end Acquisition.impl;

  -- ------------------------------------------------------------------ sistema
  system Gateway
  end Gateway;
 
  system implementation Gateway.impl
    subcomponents
      temp   : device TempSensor;
      acq    : process Acquisition.impl;
      out_if : device OutputIf;
      cpu    : processor Cpu;
      ram    : memory Ram;
      ic     : bus InternalBus;
    connections
      -- Topologia física: quem está pendurado no barramento.
      -- Acesso a barramento é bidirecional (<->): o barramento é um meio
      -- compartilhado, não um fluxo com sentido.
      h1 : bus access ic <-> temp.bus_ic;
      h2 : bus access ic <-> cpu.bus_ic;
      h3 : bus access ic <-> ram.bus_ic;
      h4 : bus access ic <-> out_if.bus_ic;
      -- Caminho lógico das mensagens
      m1 : port temp.msg_out -> acq.msg_in;
      m2 : port acq.msg_out -> out_if.msg_in;
    flows
      -- Requisito de latência: do sensor até a saída em no máximo 50 ms
      e2e : end to end flow temp.src -> m1 -> acq.fp -> m2 -> out_if.snk {
        Latency => 0 ms .. 50 ms;
      };
    properties
      -- Binding: onde o software roda e por onde as mensagens passam
      Actual_Processor_Binding  => (reference (cpu)) applies to acq;
      Actual_Memory_Binding     => (reference (ram)) applies to acq;
      Actual_Connection_Binding => (reference (ic))  applies to m1, m2;
  end Gateway.impl;

end GatewayMini;
