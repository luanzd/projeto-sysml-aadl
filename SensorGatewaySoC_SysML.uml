  <Requirements:Requirement xmi:id="_SobtIME1EfGNKtEunPCNwA" base_NamedElement="_SoYp0ME1EfGNKtEunPCNwA" id="RQ01" text="O sistema deve receber mensagens de pelo menos três tipos de sensores (temperatura, luminosidade, movimento)." base_Class="_SoYp0ME1EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_gBadoMF7EfGNKtEunPCNwA" base_NamedElement="_gBTv8MF7EfGNKtEunPCNwA" id="RQ02" text="Cada mensagem deve conter identificador de origem, tipo, valor e prioridade." base_Class="_gBTv8MF7EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_ll0E4MF8EfGNKtEunPCNwA" base_NamedElement="_llxBkMF8EfGNKtEunPCNwA" id="RQ04" text="O sistema deve armazenar temporariamente mensagens que não possam ser transmitidas imediatamente." base_Class="_llxBkMF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_nvNaUMF8EfGNKtEunPCNwA" base_NamedElement="_nvIh0MF8EfGNKtEunPCNwA" id="RQ05" text="O sistema deve indicar condição de buffer cheio." base_Class="_nvIh0MF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_o6-C0MF8EfGNKtEunPCNwA" base_NamedElement="_o63VIMF8EfGNKtEunPCNwA" id="RQ06" text="O sistema deve registrar o número de mensagens processadas por sensor." base_Class="_o63VIMF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_p_QxYMF8EfGNKtEunPCNwA" base_NamedElement="_p_JcoMF8EfGNKtEunPCNwA" id="RQ07" text="O sistema deve descartar ou marcar mensagens inválidas." base_Class="_p_JcoMF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_rZxAgMF8EfGNKtEunPCNwA" base_NamedElement="_rZvLUMF8EfGNKtEunPCNwA" id="RQ08" text="O sistema deve suportar ao menos dois níveis de prioridade." base_Class="_rZvLUMF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_vzbIYMF8EfGNKtEunPCNwA" base_NamedElement="_vzVo0MF8EfGNKtEunPCNwA" id="RQ03" text="Eventos críticos devem ser encaminhados antes de mensagens periódicas não críticas." base_Class="_vzVo0MF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_6fm-QMF8EfGNKtEunPCNwA" base_NamedElement="_6fj68MF8EfGNKtEunPCNwA" id="RQ09" text="O sistema deve transmitir mensagens em formato padronizado." base_Class="_6fj68MF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_7ZLqkMF8EfGNKtEunPCNwA" base_NamedElement="_7ZJOUMF8EfGNKtEunPCNwA" id="RQ10" text="O sistema deve entrar em modo de degradação se a interface de saída estiver indisponível." base_Class="_7ZJOUMF8EfGNKtEunPCNwA"/>
  <Requirements:Requirement xmi:id="_w0JgwMHYEfGwWInniLvjbQ" base_NamedElement="_wznVQMHYEfGwWInniLvjbQ" id="RQ11" text="O evento crítico de movimento deve ser transmitido à saída em no máximo 100 ms." base_Class="_wznVQMHYEfGwWInniLvjbQ"/>
  <Requirements:Requirement xmi:id="_ONqYcMHZEfGwWInniLvjbQ" base_NamedElement="_ONfZUMHZEfGwWInniLvjbQ" id="RQ12" text="O buffer deve ter capacidade limitada de 4 mensagens críticas e 16 mensagens periódicas." base_Class="_ONfZUMHZEfGwWInniLvjbQ"/>
